# ==========================================
# 🤖 Discord Bot Configuration (Backend)
# ==========================================

# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ==========================================
# ☁️ Database Configuration (Turso Cloud SQLite)
# ==========================================
# Leave empty to use local SQLite (data/bot.db)
# Or paste your Turso database credentials from https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ==========================================
# 🧠 AI Tutor Configuration (xAI Grok / Google Gemini)
# ==========================================
# Preferred AI provider: 'grok' or 'gemini' (defaults to grok if key is provided)
AI_PROVIDER=grok

# xAI Grok API Key from https://console.x.ai/
GROK_API_KEY=your_xai_grok_key_here
GROK_MODEL=grok-2-latest

# Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ==========================================
# ⏰ Default Notification Schedule
# ==========================================
# 24-hour format in your local timezone (e.g. 8 for 8:00 AM)
DAILY_REMINDER_HOUR=8
DAILY_REMINDER_MINUTE=0
